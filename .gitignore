dist/
*.so
*.h

# Go
*.test
*.out
.workbuddy/*
.test*

# local cgo-shim verification temp dirs (scripts/cgo-shim-build.py)
cpa-shim-*/

# python bytecode cache
__pycache__/
*.pyc
tmp_ws_probe

# AI-host tool data dirs (CodeGraph DB / Codex plan projections)
.codegraph/
.zcode/

# local-only credentials & probe scratch (never committed)
.local_cookie.txt
.tmp-cookie-copy/
tmp_collect_cookie.py
tmp_extract_cookie.py
tmp_probe_*.py

# qwenwork login probe scratch (credentials never committed)
.qwenwork-probe/

# local release asset cache (binaries are published to GitHub Releases)
release-assets/

# runtime usage feed produced by the plugins at run time (not source)
data/
cursor/internal/plugin/data/

# local Go scratch module and embedded Python runtime (environment-specific)
.p5/
Python/

# AI-host session scratch dirs
.workbuddy-ai/
